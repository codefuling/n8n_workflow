    {
      "id": "code-compose",
      "name": "브리핑 메시지 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 날씨 아이템과 뉴스 아이템을 분리\nconst all = $input.all().map(i => i.json);\n\nconst weatherItem = all.find(j => j && j.current && j.current.temperature_2m !== undefined);\nconst newsItems = all.filter(j => j && j.title && j.link);\n\nconst wmo = {\n  0: '맑음', 1: '대체로 맑음', 2: '부분적으로 흐림', 3: '흐림',\n  45: '안개', 48: '착빙 안개',\n  51: '약한 이슬비', 53: '이슬비', 55: '짙은 이슬비',\n  61: '약한 비', 63: '비', 65: '강한 비',\n  71: '약한 눈', 73: '눈', 75: '강한 눈',\n  80: '약한 소나기', 81: '소나기', 82: '강한 소나기',\n  95: '천둥번개', 96: '천둥번개(약한 우박)', 99: '천둥번개(강한 우박)'\n};\n\nlet weatherText = '날씨 정보를 불러오지 못했습니다.';\nif (weatherItem) {\n  const c = weatherItem.current;\n  const d = weatherItem.daily;\n  const desc = wmo[c.weather_code] ?? `코드 ${c.weather_code}`;\n  const tmax = Array.isArray(d.temperature_2m_max) ? d.temperature_2m_max[0] : d.temperature_2m_max;\n  const tmin = Array.isArray(d.temperature_2m_min) ? d.temperature_2m_min[0] : d.temperature_2m_min;\n  const pop = Array.isArray(d.precipitation_probability_max) ? d.precipitation_probability_max[0] : d.precipitation_probability_max;\n  weatherText = [\n    `현재 ${c.temperature_2m}°C (체감 ${c.apparent_temperature}°C), ${desc}`,\n    `최고 ${tmax}°C / 최저 ${tmin}°C · 강수확률 ${pop ?? 0}% · 습도 ${c.relative_humidity_2m}% · 바람 ${c.wind_speed_10m}km/h`\n  ].join('\\n');\n}\n\nconst top5 = newsItems.slice(0, 5).map((n, idx) => {\n  const title = (n.title || '').replace(/\\s+/g, ' ').trim();\n  return `${idx + 1}. <${n.link}|${title}>`;\n}).join('\\n');\n\nconst dateStr = new Date().toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' });\n\nconst slackText = [\n  `:sunny: *${dateStr} 아침 브리핑*`,\n  ``,\n  `*오늘의 날씨 (서울)*`,\n  weatherText,\n  ``,\n  `*인기 뉴스 TOP 5*`,\n  top5 || '뉴스를 불러오지 못했습니다.'\n].join('\\n');\n\nreturn [{ json: { slackText } }];"
      }
    },
