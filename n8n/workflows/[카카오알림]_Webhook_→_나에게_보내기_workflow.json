      },
      "id": "d4e5f6a7-0001-4000-8000-000000000001",
      "name": "Webhook 수신",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        304
      ],
      "webhookId": "e76d41ee-269f-405a-aabb-aa04cb9723cb"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 카카오 액세스 토큰 (환경변수에서 직접 사용)\nconst accessToken = $env.KAKAO_ACCESS_TOKEN;\nif (!accessToken) {\n  throw new Error('환경변수 KAKAO_ACCESS_TOKEN 이 설정되지 않았습니다.');\n}\n\n// Webhook 본문에서 메시지/링크 추출\nconst hook = $('Webhook 수신').item.json;\nconst payload = hook.body || hook.query || {};\nconst message = (payload.message || payload.text || '알림').toString();\nconst link = (payload.link || payload.url || '').toString();\n\nconst templateObject = {\n  object_type: 'text',\n  text: message,\n  link: link\n    ? { web_url: link, mobile_web_url: link }\n    : { web_url: 'https://developers.kakao.com', mobile_web_url: 'https://developers.kakao.com' },\n};\nif (link) templateObject.button_title = '열기';\n\nreturn {\n  json: {\n    accessToken,\n    template_object: JSON.stringify(templateObject),\n  },\n};\n"
      },
      "id": "d4e5f6a7-0003-4000-8000-000000000003",
      "name": "메시지 조립",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kapi.kakao.com/v2/api/talk/memo/default/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "template_object",
              "value": "={{ $json.template_object }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d4e5f6a7-0004-4000-8000-000000000004",
      "name": "카카오 나에게 전송",
