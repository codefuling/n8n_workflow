        ]
      ]
    },
    "OG 이미지 추출": {
      "main": [
        [
          {
            "node": "메일 내용 구성",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "메일 내용 구성": {
      "main": [
        [
          {
            "node": "SMTP 메일 발송",
            "type": "main",
